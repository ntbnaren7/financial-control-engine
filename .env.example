ENVIRONMENT=development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# FCE canonical database — PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fce

# --- Demo runner ---
# To run the demo locally without a PostgreSQL server, pass --db-url explicitly:
#   uv run python scripts/run_demo.py --reset --records 100 --db-url sqlite:///sqlite.db
# This keeps the canonical .env pointed at PostgreSQL at all times.
